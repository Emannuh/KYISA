# ─────────────────────────────────────────────────────────────────────────────
# KYISA CMS — Production Environment Variables (Truehost VPS)
# Copy this to /opt/kyisa/.env on the server — NEVER commit .env to git
# ─────────────────────────────────────────────────────────────────────────────

# ── DJANGO CORE ───────────────────────────────────────────────────────────────
SECRET_KEY=REPLACE-with-output-of: python -c "import secrets; print(secrets.token_urlsafe(64))"
DEBUG=False
ALLOWED_HOSTS=kyisa.org,www.kyisa.org,YOUR_SERVER_IP

# ── DATABASE (Postgres running in Docker on same server) ──────────────────────
DATABASE_URL=postgres://kyisa_user:REPLACE_DB_PASSWORD@kyisa-db:5432/kyisa_db
DB_NAME=kyisa_db
DB_USER=kyisa_user
DB_PASSWORD=REPLACE_DB_PASSWORD

# ── EMAIL (Zoho Mail SMTP — use your kyisa.org mailbox) ──────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.zoho.com
EMAIL_PORT=587
EMAIL_HOST_USER=noreply@kyisa.org
EMAIL_HOST_PASSWORD=REPLACE_ZOHO_APP_PASSWORD
DEFAULT_FROM_EMAIL=KYISA Administration <noreply@kyisa.org>
ADMIN_EMAIL=admin@kyisa.org
SERVER_EMAIL=server@kyisa.org

# ── MEDIA STORAGE (local disk on VPS — files survive in /opt/kyisa/media) ────
STORAGE_BACKEND=

# ── CORS / CSRF ───────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://kyisa.org,https://www.kyisa.org
CSRF_TRUSTED_ORIGINS=https://kyisa.org,https://www.kyisa.org

# ── REDIS (leave blank — uses in-memory cache, fine for single server) ────────
REDIS_URL=

# ── M-PESA DARAJA ─────────────────────────────────────────────────────────────
MPESA_ENVIRONMENT=production
MPESA_CONSUMER_KEY=REPLACE_ME
MPESA_CONSUMER_SECRET=REPLACE_ME
MPESA_SHORTCODE=REPLACE_ME
MPESA_PASSKEY=REPLACE_ME
MPESA_CALLBACK_URL=https://kyisa.org/api/mpesa/callback/



# ── KYISA BANK DETAILS ────────────────────────────────────────────────────────
KYISA_BANK_NAME=Kenya Commercial Bank (KCB)
KYISA_BANK_BRANCH=REPLACE_ME
KYISA_BANK_ACCOUNT_NAME=Kenya Youth Inter-County Sports Association
KYISA_BANK_ACCOUNT_NO=REPLACE_ME
KYISA_BANK_SWIFT_CODE=REPLACE_ME
KYISA_MPESA_PAYBILL=REPLACE_ME
KYISA_MPESA_ACCOUNT_NO=REPLACE_ME
